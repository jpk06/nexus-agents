# 复制成 .env 再填值：cp .env.example .env
# .env 已被 .gitignore 忽略 —— 密钥永远不要进版本库。

# ---- 模型端点 ----------------------------------------------------------
# 托管端点：填 NEXUS_API_KEY
NEXUS_API_KEY=
NEXUS_MODEL=gpt-4o-mini
# 本地端点（vLLM / Ollama / LM Studio）：填这个，密钥可以留空
# NEXUS_BASE_URL=http://host.docker.internal:11434/v1

# ---- 服务闸门 ----------------------------------------------------------
# 设了之后所有 /sessions 请求必须带 X-API-Key 头；留空 = 不校验
NEXUS_SERVICE_KEY=

# ---- 运行参数 ----------------------------------------------------------
NEXUS_LOG_LEVEL=info
# 宿主机端口（容器内固定 8000）
NEXUS_HOST_PORT=8000
NEXUS_MAX_SESSIONS=1000
NEXUS_SESSION_TTL=3600
NEXUS_MAX_INPUT_CHARS=8000
